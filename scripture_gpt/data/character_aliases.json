  "normalization_rules": {
    "description": "Rules for normalising Sanskrit diacritics to ASCII for alias matching",
    "diacritic_map": {
      "a_macron": {"from": "aa", "to": "a", "unicode": "U+0101"},
      "i_macron": {"from": "ii", "to": "i", "unicode": "U+012B"},
      "u_macron": {"from": "uu", "to": "u", "unicode": "U+016B"},
      "sha_palatal": {"from": "sh", "to": "s", "unicode": "U+015B"},
      "sha_retroflex": {"from": "sh", "to": "s", "unicode": "U+1E63"},
      "m_anusvara": {"from": "m", "to": "m", "unicode": "U+1E43"},
      "t_retroflex": {"from": "t", "to": "t", "unicode": "U+1E6D"},
      "d_retroflex": {"from": "d", "to": "d", "unicode": "U+1E0D"},
      "n_retroflex": {"from": "n", "to": "n", "unicode": "U+1E47"}
    },
    "ascii_substitutions": [
      {"pattern": "aa", "replacement": "a", "example": "Raama -> Rama"},
      {"pattern": "ii", "replacement": "i", "example": "Siita -> Sita"},
      {"pattern": "uu", "replacement": "u", "example": "Suurya -> Surya"},
      {"pattern": "sh", "replacement": "s", "example": "Raamesh -> Rames"},
      {"pattern": "ee", "replacement": "i", "example": "Seeta -> Sita"}
    ],
    "case_fold": true,
    "strip_punctuation": true,
    "rules": [
      "Apply diacritic_map character substitutions before any matching",
      "Lowercase all text when case_fold is true",
      "Strip leading and trailing whitespace",
      "Collapse multiple internal spaces to single space",
      "Remove punctuation when strip_punctuation is true before alias lookup"
    ]
  }
